{
  "manifest_version": 3,
  "name": "Chrono for Selfkit",
  "short_name": "Chrono",
  "version": "0.1.0",
  "description": "Records which website (domain only) is in front and for how long, for your own Chrono app. Private windows are never tracked. Nothing leaves your computer.",
  "key": "",
  "permissions": ["tabs", "idle", "alarms", "storage", "nativeMessaging"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Chrono",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "incognito": "spanning",
  "minimum_chrome_version": "116",
  "browser_specific_settings": {
    "gecko": {
      "id": "chrono@selfkit",
      "strict_min_version": "121.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
