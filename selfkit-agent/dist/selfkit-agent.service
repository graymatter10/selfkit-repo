# Selfkit agent — systemd user unit. Easiest: `selfkit-agent install-service [--enable]`
# writes this with the right path. Manual: copy to ~/.config/systemd/user/, then
#   systemctl --user daemon-reload && systemctl --user enable --now selfkit-agent
# i3 (~/.config/i3/config) — hand the X display to user services, then (re)start:
#   exec --no-startup-id systemctl --user import-environment DISPLAY XAUTHORITY && systemctl --user restart selfkit-agent
# Docs: docs/platforms/linux.md
[Unit]
Description=Selfkit agent (activity tracking, sync, backups, reminders)
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/selfkit-agent run
Restart=on-failure
RestartSec=10
MemoryMax=64M
Nice=5

[Install]
WantedBy=default.target
