<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into every Selfkit app. Each app sets meta-data com.selfkit.sync.APP / .LIB (see README.md). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.selfkit.sync" >

    <uses-sdk android:minSdkVersion="24" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- MulticastLock: receive LAN discovery broadcasts while a sync pass runs. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Lets the app open the "ignore battery optimisations" screen. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Only apps signed with the same key (other Selfkit apps, a future companion) may use the providers. -->
    <permission
        android:name="com.selfkit.permission.SHARE"
        android:label="Share Selfkit data between Selfkit apps"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.selfkit.permission.SHARE" />

    <!-- Other Selfkit apps' providers (package visibility, Android 11+); used by SelfkitMirror. -->
    <queries>
        <provider android:authorities="com.selfkit.chrono.provider" />
        <provider android:authorities="com.selfkit.hisab.provider" />
        <provider android:authorities="com.selfkit.agenda.provider" />
        <provider android:authorities="com.selfkit.dusk.provider" />
        <provider android:authorities="com.selfkit.reflect.provider" />
    </queries>

    <application>
        <provider
            android:name="com.selfkit.sync.SelfkitDataProvider"
            android:authorities="dollar_openBracket_applicationId_closeBracket.provider"
            android:exported="true"
            android:permission="com.selfkit.permission.SHARE" />
    </application>

</manifest>