{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hisab",
  "version": "0.1.2",
  "identifier": "com.selfkit.hisab",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5175",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hisab",
        "width": 1180,
        "height": 780,
        "minWidth": 360,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost https://open.er-api.com; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis"
    ],
    "icon": [
      "../icons/32x32.png",
      "../icons/128x128.png",
      "../icons/128x128@2x.png",
      "../icons/icon.png",
      "../icons/icon.ico"
    ],
    "category": "Finance",
    "shortDescription": "Money, offline and private",
    "publisher": "Selfkit",
    "copyright": "Selfkit",
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Selfkit",
        "languages": ["English"],
        "customLanguageFiles": { "English": "../../../installer/windows/app-english.nsh" },
        "installerHooks": "../../../installer/windows/app-hooks.nsh"
      }
    }
  }
}