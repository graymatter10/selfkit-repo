<?xml version="1.0" encoding="utf-8"?>
<!-- Security (docs/security.md): the local databases are plaintext SQLite. Keep them out of
     Google cloud backup and device-to-device transfer; data moves through encrypted Selfkit
     sync and .skb backups instead. Used together with android:allowBackup="false". -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
